{
  "name": "rsk-jewellery-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the RSK Jewellers management system (SQLite dev/test persistence).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed/run.js",
    "start:render": "node src/db/seed/run.js && node src/server.js",
    "test": "node --test tests/**/*.test.js"
  },
  "engines": { "node": ">=20 <25" },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
